    <string name="hadith_header">The Trees of Paradise</string>
    <string name="hadith_arabic">سُبْحَانَ اللهِ، وَالْحَمْدُ لِلَّهِ، وَلَا إِلَهَ إِلَّا اللهُ، وَاللهُ أَكْبُرُ</string>
    <string name="hadith_translation">\"SubhanAllah, Alhamdulillah, La ilaha illallah, and Allahu Akbar — these are the trees of Paradise. For every time you say one of them, a tree is planted for you in Paradise.\"</string>
