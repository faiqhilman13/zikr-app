# Usage analytics are served by this site's own Netlify function and need no endpoint.
# ANALYTICS_ADMIN_KEY is the password for the private dashboard at /analytics.html.
# Set it in Netlify under Site configuration -> Environment variables, scoped to
# Functions. It has no VITE_ prefix on purpose: Vite inlines VITE_* into the browser
# bundle, which would publish the key. Do not commit its value.
ANALYTICS_ADMIN_KEY=

# Cloud sync is intentionally not included in the public PWA.
# Use encrypted backup export/import to move between devices.

# Optional daily reminders. This site's own functions send them, so no push provider
# is needed:
#   netlify/functions/push.mjs        turns one browser's reminder on and off
#   netlify/functions/push-send.mjs   every five minutes, sends the reminders now due
#   netlify/functions/push-sweep.mjs  once a day, repairs the schedule
# `npm run vapid-keys` prints a key pair and these four lines with the scope each belongs
# in; set them in Netlify, as with ANALYTICS_ADMIN_KEY, and deploy. Without the first two
# the app shows reminders as unavailable. Without the last two the functions refuse to
# store a subscription, so the app says it could not turn them on rather than promising a
# reminder nobody can send.
#
# Keep the pair once browsers are subscribed with it. A new one leaves each subscription
# undeliverable until its browser opens the app again and subscribes anew.
#
# Builds scope.
VITE_PUSH_ENDPOINT=/.netlify/functions/push
# Builds and Functions scopes. The public half: the app subscribes with it, and the
# functions check the private half against it.
VITE_VAPID_PUBLIC_KEY=
# Functions scope only. The private half, which signs every reminder. Do not commit its
# value.
VAPID_PRIVATE_KEY=
# Functions scope only. A mailto: address or an https:// page where push services can
# reach whoever runs the site.
VAPID_SUBJECT=

# Never put a private key in a VITE_* variable; Vite exposes these to browsers.
