# Usage analytics are served by this site's own Netlify function and need no endpoint.
# ANALYTICS_ADMIN_KEY is the password for the private dashboard at /analytics.html.
# Set it in Netlify under Site configuration -> Environment variables, scoped to
# Functions. It has no VITE_ prefix on purpose: Vite inlines VITE_* into the browser
# bundle, which would publish the key. Do not commit its value.
ANALYTICS_ADMIN_KEY=

# Cloud sync is intentionally not included in the public PWA.
# Use encrypted backup export/import to move between devices.

# Optional Web Push subscription endpoint and VAPID public key.
# The app POSTs JSON to VITE_PUSH_ENDPOINT with an "action" field:
#   { action: "subscribe", subscription, preferredTime, timeZone }
#   { action: "unsubscribe", endpoint }
# Honor "unsubscribe" server-side; the client also unsubscribes locally, which
# invalidates the subscription at the push service either way.
VITE_PUSH_ENDPOINT=
VITE_VAPID_PUBLIC_KEY=

# Never put a private key in a VITE_* variable; Vite exposes these to browsers.
